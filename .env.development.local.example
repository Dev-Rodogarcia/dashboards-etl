# Copie para .env.development.local e preencha com credenciais de DEV.
# Este arquivo real e ignorado pelo Git e nunca deve apontar para o banco DASHBOARDS de producao.

ENVIRONMENT=dev
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:sqlserver://HOST_DEV:1433;databaseName=DASHBOARDS_DEV;encrypt=true;trustServerCertificate=true
DB_USER=usuario_dev
DB_PASSWORD=senha_dev

JWT_SECRET=troque-por-um-segredo-local-com-pelo-menos-32-caracteres
API_KEY=troque-por-uma-chave-local

ACESSO_USUARIO_SUPREMO_EMAIL=dev@example.local
ACESSO_USUARIO_SUPREMO_SENHA_INICIAL=troque-esta-senha-local
ACESSO_USUARIO_SUPREMO_NOME=Usuario DEV
ACESSO_USUARIO_SUPREMO_PAPEL=desenvolvedor
ACESSO_USUARIO_SUPREMO_NIVEL=1000

AUTH_SESSION_EXPIRACAO_HORAS=24
AUTH_REFRESH_COOKIE_SECURE=false
SECURITY_TRUST_FORWARDED_HEADERS=false

# Exemplo para produção na VM atras do Cloudflare Tunnel.
# Copie para .env na VM e substitua todos os placeholders sensiveis.

ENVIRONMENT=production
SPRING_PROFILES_ACTIVE=prod

API_BASE_URL=https://api-analytics.rodogarcia.com.br
VITE_API_BASE_URL=https://api-analytics.rodogarcia.com.br
APP_INTEGRATION_SATELITE_URL=http://127.0.0.1:19090
VITE_API_REQUEST_TIMEOUT_MS=90000
VITE_API_DOWNLOAD_TIMEOUT_MS=120000
VITE_AUTH_REQUEST_TIMEOUT_MS=15000
VITE_HOME_COMUNICADOS_API_ENABLED=true

SERVER_ADDRESS=127.0.0.1
CORS_ORIGENS_PERMITIDAS=https://analytics.rodogarcia.com.br
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=2MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=3MB

DB_URL=jdbc:sqlserver://HOST:1433;databaseName=DASHBOARDS;encrypt=true;trustServerCertificate=true
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

JWT_SECRET=defina-um-segredo-forte-e-unico-por-ambiente
API_KEY=defina-uma-chave-forte-e-unica-para-rotas-internas
ADMIN_INITIAL_PASSWORD=defina-uma-senha-inicial-local

DASHBOARD_INDICADORES_CUBAGEM_PAGADOR_DOCS_EXCLUIDOS=

AUTH_SESSION_EXPIRACAO_HORAS=24
AUTH_REFRESH_COOKIE_NAME=dashboard_refresh_token
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax

ACESSO_USUARIO_SUPREMO_EMAIL=admin-seguro@empresa.com
ACESSO_USUARIO_SUPREMO_SENHA_INICIAL=troque-por-uma-senha-forte
ACESSO_USUARIO_SUPREMO_NOME=Administrador Supremo
ACESSO_USUARIO_SUPREMO_PAPEL=desenvolvedor
ACESSO_USUARIO_SUPREMO_NIVEL=1000
ACESSO_USUARIO_SUPREMO_ROTACIONAR_SENHA=true
VITE_ACESSO_USUARIO_SUPREMO_PAPEL=desenvolvedor

ACL_STORAGE_FILE=./storage/access-control.json
ACL_LEGACY_MIGRATION_ENABLED=false

SECURITY_TRUST_FORWARDED_HEADERS=true
SECURITY_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
SECURITY_RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
SECURITY_RATE_LIMIT_API_MAX_REQUESTS=120
SECURITY_RATE_LIMIT_API_WINDOW_SECONDS=60
SECURITY_RATE_LIMIT_EXPORT_MAX_REQUESTS=12
SECURITY_RATE_LIMIT_EXPORT_WINDOW_SECONDS=60

ACESSO_RETENCAO_REFRESH_TOKEN_EXPIRADO_DIAS=30
ACESSO_RETENCAO_AUDIT_LOG_DIAS=90
ACESSO_RETENCAO_CRON=0 30 3 * * *
